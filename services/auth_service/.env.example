# Copy to .env when running the auth service standalone.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/lostfound
JWT_PRIVATE_KEY_PATH=infra/keys/jwt.key
JWT_PUBLIC_KEY_PATH=infra/keys/jwt.pub
ACCESS_TOKEN_TTL_SECONDS=3600
NATS_URL=nats://127.0.0.1:4222
NATS_SUBJECT_PREFIX=lostfound.
